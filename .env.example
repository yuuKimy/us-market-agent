# Copy to .env and fill in. .env is git-ignored.
# Used by both the Alpaca MCP server (.cursor/mcp.json envFile) and the Python CLI.

# Alpaca paper trading keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Historical bar feed: "iex" (works for paper-only accounts) or "sip" (all US exchanges; check that your
# account and market data plan include SIP)
ALPACA_DATA_FEED=iex

# FRED API key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
